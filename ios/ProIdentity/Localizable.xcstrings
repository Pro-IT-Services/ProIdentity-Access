    "Can't reach the server. Check the address and try again.": {
      "localizations": {
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Server je nedostupný. Skontrolujte adresu a skúste to znova."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server není dostupný. Zkontrolujte adresu a zkuste to znovu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z serwerem. Sprawdź adres i spróbuj ponownie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver nem érhető el. Ellenőrizze a címet, és próbálja újra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist nicht erreichbar. Prüfen Sie die Adresse und versuchen Sie es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il server. Verifichi l'indirizzo e riprovi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con el servidor. Compruebe la dirección e inténtelo de nuevo."
          }
        }
      }
    },
