    "All connections and settings are removed from this device. This can't be undone.": {
      "localizations": {
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky pripojenia a nastavenia sa z tohto zariadenia odstránia. Túto akciu nemožno vrátiť späť."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechna připojení a nastavení se z tohoto zařízení odstraní. Tuto akci nelze vrátit zpět."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie połączenia i ustawienia zostaną usunięte z tego urządzenia. Tej operacji nie można cofnąć."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden kapcsolat és beállítás eltávolításra kerül erről az eszközről. Ez nem vonható vissza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Verbindungen und Einstellungen werden von diesem Gerät entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le connessioni e le impostazioni vengono rimosse da questo dispositivo. L'operazione non può essere annullata."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan de este dispositivo todas las conexiones y los ajustes. Esta acción no se puede deshacer."
          }
        }
      }
    },
