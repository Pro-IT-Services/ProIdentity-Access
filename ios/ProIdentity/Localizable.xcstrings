    "Signing out disconnects server connections. Imported configurations stay on this device.": {
      "localizations": {
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlásenie odpojí pripojenia k serverom. Importované konfigurácie zostanú v tomto zariadení."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlášení odpojí připojení k serveru. Importované konfigurace zůstanou na tomto zařízení."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogowanie rozłącza połączenia z serwerem. Zaimportowane konfiguracje pozostają na tym urządzeniu."
          }
        },
        "hu": {
          "stringUnit": {
