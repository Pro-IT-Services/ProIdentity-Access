    "A fresh key and address are issued each time you connect.": {
      "localizations": {
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri každom pripojení sa vydá nový kľúč a adresa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při každém připojení se vydá nový klíč a adresa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy każdym połączeniu wydawany jest nowy klucz i adres."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden csatlakozáskor új kulcs és cím kerül kiosztásra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei jeder Verbindung werden ein neuer Schlüssel und eine neue Adresse ausgestellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A ogni connessione vengono rilasciati una chiave e un indirizzo nuovi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que se conecta se emiten una clave y una dirección nuevas."
          }
        }
      }
    },
    "A unique encryption key is created on this device. It never leaves it.": {
      "localizations": {
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto zariadení sa vytvorí jedinečný šifrovací kľúč, ktorý ho nikdy neopustí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tomto zařízení se vytvoří jedinečný šifrovací klíč. Nikdy jej neopustí."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym urządzeniu tworzony jest unikalny klucz szyfrowania. Nigdy go nie opuszcza."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyedi titkosítási kulcs jön létre ezen az eszközön. Soha nem hagyja el."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät wird ein eindeutiger Verschlüsselungsschlüssel erzeugt. Er verlässt das Gerät nie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su questo dispositivo viene creata una chiave di crittografia univoca, che non lo lascia mai."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este dispositivo se crea una clave de cifrado única. Nunca sale de él."
          }
        }
      }
    },
