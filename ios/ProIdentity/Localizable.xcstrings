          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abmelden werden Serververbindungen getrennt. Importierte Konfigurationen bleiben auf diesem Gerät."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscendo si disconnettono le connessioni al server. Le configurazioni importate restano su questo dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar la sesión se desconectan las conexiones del servidor. Las configuraciones importadas permanecen en este dispositivo."
