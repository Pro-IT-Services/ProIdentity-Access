    "Your session expired. Sign in again to continue.": {
      "localizations": {
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša relácia vypršala. Ak chcete pokračovať, znova sa prihláste."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše relace vypršela. Pro pokračování se znovu přihlaste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja sesja wygasła. Zaloguj się ponownie, aby kontynuować."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A munkamenete lejárt. A folytatáshoz jelentkezzen be újra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Sitzung ist abgelaufen. Melden Sie sich erneut an, um fortzufahren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua sessione è scaduta. Acceda di nuovo per continuare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su sesión ha caducado. Inicie sesión de nuevo para continuar."
          }
        }
      }
    },
