        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrator nie przyznał Ci jeszcze dostępu do serwera. Pociągnij w dół, aby odświeżyć."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszergazda még nem adott hozzáférést egy szerverhez. Húzza le a frissítéshez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Administrator hat Ihnen noch keinen Zugriff auf einen Server gewährt. Ziehen Sie nach unten, um zu aktualisieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo amministratore non le ha ancora concesso l'accesso a un server. Tiri verso il basso per aggiornare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su administrador aún no le ha dado acceso a un servidor. Deslice hacia abajo para actualizar."
          }
        }
      }
    },
    "Your administrator sees this name in the device list. This registers it with %@.": {
      "localizations": {
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Správca uvidí tento názov v zozname zariadení. Týmto zariadenie zaregistrujete na serveri %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš správce vidí tento název v seznamu zařízení. Tím se zaregistruje u %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrator widzi tę nazwę na liście urządzeń. Spowoduje to zarejestrowanie urządzenia w %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszergazda ezt a nevet látja az eszközlistában. Ez regisztrálja a következőnél: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Administrator sieht diesen Namen in der Geräteliste. Dies registriert es bei %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo amministratore vede questo nome nell'elenco dei dispositivi. Questo lo registra con %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su administrador ve este nombre en la lista de dispositivos. Esto lo registra con %@."
          }
        }
      }
    },
