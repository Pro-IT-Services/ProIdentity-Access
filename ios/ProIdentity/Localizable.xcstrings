    "Your administrator hasn't given you access to a server yet. Pull down to refresh." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Správca vám zatiaľ neudelil prístup k žiadnemu serveru. Potiahnutím nadol obnovíte zoznam."
          }
